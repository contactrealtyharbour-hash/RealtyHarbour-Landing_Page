{
  // Cloudflare Worker "realtyharbour": serves the static site from dist/ and handles POST /api/lead.
  // `npx wrangler deploy` runs build.sh first (see "build"), so no dashboard build command is needed.
  "name": "realtyharbour",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "sh build.sh" },
  "keep_vars": true,
  "vars": {
    "LEAD_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbwsSZH4-QVpMjAM7m_TnSfg-s9RRsRiTQwfsO_zSnynJ4CAbOC0DIoJewtJg9zSITBU/exec"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Browser form posts are navigation requests; without this the asset layer answers them with 405.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
